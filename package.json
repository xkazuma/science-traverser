{
  "name": "pdf-viewer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "type-check": "vue-tsc -p tsconfig.app.json --noEmit && vue-tsc -p tsconfig.vitest.json --noEmit && vue-tsc -p tsconfig.node.json --noEmit",
    "build": "pnpm run type-check && vite build",
    "test": "vitest run"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "pdfjs-dist": "^6.0.227",
    "pinia": "^2.2.6",
    "vite-plugin-vuetify": "^2.1.3",
    "vue": "^3.5.13",
    "vuetify": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.1.10"
  }
}
